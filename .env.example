# PayGuard sandbox configuration template.
# Copy to .env and fill in values. NEVER commit a real .env.

# PayPal sandbox credentials (free: https://developer.paypal.com/ -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# LLM providers - at least one enables the live agent (Gemini preferred, Groq fast lane)
# Gemini free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq free key: https://console.groq.com/keys
GROQ_API_KEY=

# API server
PORT=4000

# Optional local infrastructure (docker-compose) - the hackathon build runs
# fully in-memory without these; they exist for the Postgres/Redis roadmap.
POSTGRES_USER=payguard
POSTGRES_PASSWORD=payguard
POSTGRES_DB=payguard
DATABASE_URL=postgresql://payguard:payguard@localhost:5432/payguard
REDIS_URL=redis://localhost:6379
