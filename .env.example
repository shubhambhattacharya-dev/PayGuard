# PayGuard sandbox configuration template.
# Copy to .env and fill in values. NEVER commit a real .env.

# PayPal sandbox credentials (free: https://developer.paypal.com/ -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from developer.paypal.com (Webhooks tab) - enables POST /v1/webhooks/paypal
# with signature verification + rail reconciliation. Webhooks require PostgreSQL durability.
PAYPAL_WEBHOOK_ID=

# API auth (P0: the money APIs never run unauthenticated by default).
# CSV of apiKey:ownerId pairs. Generate keys with: openssl rand -hex 32
# Example: PAYGUARD_API_KEYS=pgk_demokey1:owner_northstar,pgk_cikey2:owner_1
PAYGUARD_API_KEYS=
# Explicit demo-mode opt-out (skips auth entirely - NEVER use with real rails).
# If neither keys nor this flag are set, the API refuses to boot.
PAYGUARD_AUTH_DISABLED=false

# LLM providers - at least one enables the live agent (Gemini preferred, Groq fast lane)
# Gemini free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq free key: https://console.groq.com/keys
GROQ_API_KEY=

# API server
PORT=4000

# Web frontend -> Next.js server-side proxy (/api/payguard) targets this URL
# with PAYGUARD_API_KEY; no API key ever ships to the browser.
PAYGUARD_API_URL=http://localhost:4000
PAYGUARD_API_KEY=pgk_local_demo_key_change_me

# Optional local infrastructure (docker-compose) - webhooks/reconciliation and
# durable velocity/duplicates/audit require PostgreSQL.
POSTGRES_USER=payguard
POSTGRES_PASSWORD=payguard
POSTGRES_DB=payguard
DATABASE_URL=postgresql://payguard:payguard@localhost:5432/payguard
REDIS_URL=redis://127.0.0.1:6381
