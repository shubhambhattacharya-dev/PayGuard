{
  "name": "@payguard/api",
  "version": "1.0.0",
  "private": true,
  "description": "PayGuard API Gateway - deterministic policy gate, capped ReAct agent, PayPal sandbox executor",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@payguard/contracts": "workspace:*",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
