{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "runtime": "node",
      "entrypoint": "dist/main.js",
      "buildCommand": "pnpm --filter @payguard/contracts build && pnpm --filter @payguard/api build"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "pnpm --filter @payguard/contracts build && pnpm --filter @payguard/web build",
      "bindings": [
        {
          "type": "service",
          "service": "api",
          "format": "url",
          "env": "INTERNAL_API_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/healthz",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/v1/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
